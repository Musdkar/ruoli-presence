{
  "name": "ruoli-presence",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src api scripts test bridge/*.mjs vite.config.mjs vitest.config.mjs eslint.config.js --max-warnings=0",
    "lint:fix": "eslint src api scripts test bridge/*.mjs vite.config.mjs vitest.config.mjs eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.mjs",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && npm run build && npm run test:dist"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-photo-album": "^3.6.1",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.8",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
