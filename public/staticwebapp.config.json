{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "*.{png,jpg,jpeg,gif,svg,webp,ico,css,js}"]
  },
  "routes": [
    {
      "route": "/assets/*.{js,css}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/assets/*.{png,jpg,jpeg,gif,svg,webp,ico}",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/photos",
      "redirect": "/photo",
      "statusCode": 301
    }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=0, must-revalidate"
  }
}
